<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Management System</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f2f5f9;
            color: #333;
            padding: 20px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #2563eb;
            margin-bottom: 25px;
        }

        .top-section {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        input {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
        }

        button {
            border: none;
            padding: 10px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .add-btn {
            background: #2563eb;
            color: white;
        }

        .add-btn:hover {
            background: #1d4ed8;
        }

        .clear-btn {
            background: #ef4444;
            color: white;
        }

        .present-btn {
            background: #22c55e;
            color: white;
        }

        .absent-btn {
            background: #ef4444;
            color: white;
        }

        .delete-btn {
            background: #6b7280;
            color: white;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }

        th {
            background: #2563eb;
            color: white;
        }

        tr:nth-child(even) {
            background: #f8fafc;
        }

        .status {
            font-weight: bold;
        }

        .present {
            color: #16a34a;
        }

        .absent {
            color: #dc2626;
        }

        .summary {
            margin-top: 20px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .card {
            flex: 1;
            min-width: 150px;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            background: #eff6ff;
        }

        .card h3 {
            color: #2563eb;
        }

        @media (max-width: 700px) {
            table {
                font-size: 12px;
            }

            th, td {
                padding: 7px;
            }

            button {
                padding: 7px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>📋 Attendance Management System</h1>

    <div class="top-section">
        <input type="text" id="studentName" placeholder="Enter student name">
        <input type="text" id="studentRoll" placeholder="Roll number">

        <button class="add-btn" onclick="addStudent()">
            Add Student
        </button>

        <button class="clear-btn" onclick="clearAll()">
            Clear All
        </button>
    </div>

    <div class="summary">
        <div class="card">
            <h3 id="totalStudents">0</h3>
            <p>Total Students</p>
        </div>

        <div class="card">
            <h3 id="presentCount">0</h3>
            <p>Present Today</p>
        </div>

        <div class="card">
            <h3 id="absentCount">0</h3>
            <p>Absent Today</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Roll No.</th>
                <th>Student Name</th>
                <th>Attendance</th>
                <th>Percentage</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="studentTable">
        </tbody>
    </table>

</div>


<script>

    // Load students from browser storage
    let students = JSON.parse(localStorage.getItem("students")) || [];

    // Add a new student
    function addStudent() {

        const name = document.getElementById("studentName").value.trim();
        const roll = document.getElementById("studentRoll").value.trim();

        if (name === "" || roll === "") {
            alert("Please enter student name and roll number.");
            return;
        }

        const student = {
            id: Date.now(),
            name: name,
            roll: roll,
            present: 0,
            total: 0,
            today: ""
        };

        students.push(student);

        saveData();

        document.getElementById("studentName").value = "";
        document.getElementById("studentRoll").value = "";

        displayStudents();
    }


    // Mark attendance
    function markAttendance(id, status) {

        const student = students.find(s => s.id === id);

        if (!student) return;

        const today = new Date().toLocaleDateString();

        // Prevent marking attendance twice on the same day
        if (student.today === today) {
            alert("Attendance has already been marked for today.");
            return;
        }

        student.total++;

        if (status === "present") {
            student.present++;
        }

        student.today = today;

        saveData();
        displayStudents();
    }


    // Delete student
    function deleteStudent(id) {

        if (!confirm("Are you sure you want to delete this student?")) {
            return;
        }

        students = students.filter(student => student.id !== id);

        saveData();
        displayStudents();
    }


    // Display students
    function displayStudents() {

        const table = document.getElementById("studentTable");

        table.innerHTML = "";

        let presentToday = 0;
        let absentToday = 0;

        students.forEach(student => {

            const percentage =
                student.total === 0
                    ? 0
                    : ((student.present / student.total) * 100).toFixed(1);

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>${student.roll}</td>

                <td>${student.name}</td>

                <td>
                    <button
                        class="present-btn"
                        onclick="markAttendance(${student.id}, 'present')">
                        Present
                    </button>

                    <button
                        class="absent-btn"
                        onclick="markAttendance(${student.id}, 'absent')">
                        Absent
                    </button>
                </td>

                <td>
                    ${percentage}%
                </td>

                <td>
                    <button
                        class="delete-btn"
                        onclick="deleteStudent(${student.id})">
                        Delete
                    </button>
                </td>
            `;

            table.appendChild(row);

            const today = new Date().toLocaleDateString();

            if (student.today === today) {

                if (student.present > 0) {
                    // This is only a simple summary.
                    // Attendance history is explained below.
                }
            }
        });

        document.getElementById("totalStudents").textContent =
            students.length;

        calculateTodayAttendance();
    }


    // Calculate today's attendance
    function calculateTodayAttendance() {

        const today = new Date().toLocaleDateString();

        let present = 0;
        let absent = 0;

        students.forEach(student => {

            if (student.today === today) {

                // We determine today's result using the last attendance.
                // A separate property makes this more accurate.
                if (student.lastStatus === "present") {
                    present++;
                } else if (student.lastStatus === "absent") {
                    absent++;
                }
            }
        });

        document.getElementById("presentCount").textContent = present;
        document.getElementById("absentCount").textContent = absent;
    }


    // Save data
    function saveData() {
        localStorage.setItem("students", JSON.stringify(students));
    }


    // Clear all students
    function clearAll() {

        if (!confirm("Delete all students and attendance data?")) {
            return;
        }

        students = [];

        saveData();
        displayStudents();
    }


    // Initial display
    displayStudents();

</script>

</body>
</html>
